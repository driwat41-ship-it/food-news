# Global Food & Beverage Intelligence environment template
# Copy to .env.local for local development or configure these values in your deployment platform.

# Database
DATABASE_URL="postgresql://gfbi:gfbi_password@localhost:5432/gfbi?schema=public"
DIRECT_URL="postgresql://gfbi:gfbi_password@localhost:5432/gfbi?schema=public"

# Redis / BullMQ
REDIS_URL="redis://localhost:6379"

# OpenAI
OPENAI_API_KEY="sk-your-openai-api-key"
OPENAI_MODEL="gpt-4.1-mini"
OPENAI_FALLBACK_MODEL="gpt-4.1-nano"

# Auth
NEXTAUTH_SECRET="local-dev-secret-at-least-32-characters"
NEXTAUTH_URL="http://localhost:3000"
ADMIN_BYPASS="true"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Global Food & Beverage Intelligence"
NODE_ENV="development"
PORT="3000"

# Cron / Jobs
ENABLE_WORKERS="true"
ENABLE_CRON="true"
RSS_FETCH_INTERVAL_MINUTES="5"
AI_WORKER_CONCURRENCY="5"

# Security
INTERNAL_API_SECRET="local-internal-secret"
CRON_SECRET="local-cron-secret"

# Analytics
NEXT_PUBLIC_GA_ID=""
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=""
